# ============================================================================
# CRAVEKART - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to backend/.env and frontend/.env (or root .env) and replace
# the placeholder values with your actual credentials.
# NEVER commit real credentials or secrets to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. COCKROACHDB CONFIGURATION (Primary Database)
# ----------------------------------------------------------------------------
# For CockroachDB Cloud (Serverless / Dedicated):
# Obtain your connection string from CockroachDB Cloud Console -> Connect
# Format: postgresql://<username>:<password>@<cluster-host>:26257/<database>?sslmode=verify-full
DATABASE_URL="postgresql://your_db_user:your_db_password@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/cravekart?sslmode=verify-full"

# Separate Test Database URL (Used by automated test suite so production/dev data is never touched)
TEST_DATABASE_URL="postgresql://your_db_user:your_db_password@free-tier.gcp-us-central1.cockroachlabs.cloud:26257/cravekart_test?sslmode=verify-full"

# Optional path to CA certificate if required by your CockroachDB Cloud cluster
# COCKROACH_SSL_CERT_PATH="/path/to/root.crt"

# ----------------------------------------------------------------------------
# 2. SERVER & AUTHENTICATION SECURITY
# ----------------------------------------------------------------------------
PORT=4000
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:5173"

# Generate a strong 64-byte random hex string for signing session tokens/cookies:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET="replace_with_a_strong_64_byte_cryptographic_random_secret_key"
SESSION_COOKIE_NAME="cravekart_sid"
SESSION_TTL_HOURS=168

# Optional Admin/Developer demo key for advancing order statuses and viewing DB stats
# (In addition to RBAC role='ADMIN' / 'DEV' on user accounts)
DEV_TOOLS_ENABLED="true"

# ----------------------------------------------------------------------------
# 3. BUSINESS LOGIC & PRICING RULES (Configurable Decimal-Safe Parameters)
# ----------------------------------------------------------------------------
# GST / Restaurant Tax Rate (e.g., 0.05 = 5% GST)
TAX_RATE_PERCENT="5.00"
# Platform packaging fee in INR
PACKAGING_FEE_INR="15.00"
# Free delivery threshold in INR (if subtotal >= threshold, delivery fee discount applies)
FREE_DELIVERY_THRESHOLD_INR="499.00"

# ----------------------------------------------------------------------------
# 4. GOOGLE MAPS PLATFORM CONFIGURATION (Real Address Validation)
# ----------------------------------------------------------------------------
# Server-side Google Maps API Key (Used by backend to call Places API (New) & Geocoding API)
# Required APIs enabled in Google Cloud Console:
#   - Places API (New)
#   - Geocoding API
#   - Maps JavaScript API (for frontend map preview / autocomplete widget)
GOOGLE_MAPS_SERVER_API_KEY="YOUR_GOOGLE_MAPS_SERVER_API_KEY_HERE"

# Frontend Google Maps API Key (Restricted by HTTP Referrer to http://localhost:5173/*)
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_FRONTEND_API_KEY_HERE"
VITE_API_BASE_URL="http://localhost:4000/api"
